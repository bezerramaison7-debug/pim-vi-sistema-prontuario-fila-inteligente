digraph Clinica {
  graph [rankdir=LR, bgcolor="white", pad=.23, nodesep=.35, ranksep=.65, splines=spline];
  node [shape=record, fontname="Liberation Sans", fontsize=12, style=filled, color="#43646a", fillcolor="#f1f7f5", margin=".14,.08"];
  edge [fontname="Liberation Sans", fontsize=10, color="#426a70", fontcolor="#23454a", arrowsize=.55];
  U [label="{Unidade|PK id\lnome\l}"];
  S [label="{Consultório|PK id\lFK unidade_id\lnome\l}"];
  P [label="{Pessoa paciente|PK id\lnome, nascimento\ltelefone\l}"];
  D [label="{Profissional|PK id\lnome, especialidade\l}"];
  A [label="{Agendamento|PK id\lFK paciente_id\lFK profissional_id\lFK consultorio_id\linício, modalidade, status\l}",fillcolor="#d7eee7"];
  F [label="{Fila|PK/FK agendamento_id\lsenha, ordem, status\lchegada, chamada\linício e fim do atendimento\l}"];
  H [label="{Atendimento|PK/FK agendamento_id\lFK autor_id\lregistrado_em, resumo\l}"];
  R [label="{Usuário|PK id\lFK profissional_id (opcional)\llogin, senha_hash, perfil\l}"];
  J [label="{Documento pendente|PK id\ltipo, entidade_id\lcriado_em, conteúdo JSON\l}",style="filled,dashed"];
  U -> S [label=" 1 : N "]; S -> A [label=" 1 : N "]; P -> A [label=" 1 : N "]; D -> A [label=" 1 : N "];
  D -> R [label=" 1 : 0..1 "]; R -> H [label=" 1 : N "]; A -> F [label=" 1 : 0..1 "]; A -> H [label=" 1 : 0..1 "];
  H -> J [label=" referência lógica ",style=dashed]; A -> J [style=dashed]; P -> J [style=dashed];
}
